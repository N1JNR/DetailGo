rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Dono do shop: compara o uid autenticado com shops/{shopId}.ownerId.
    function isShopOwner(shopId) {
      return isSignedIn()
        && request.auth.uid == get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId;
    }

    // Campos que decidem acesso pago ou apontam para cobrança no Asaas. Só o
    // backend escreve: o webhook, pelo Admin SDK, que ignora estas regras.
    //
    // Sem esta trava o dono gravava `subscriptionStatus: 'active'` e
    // `activeUntil: 2099` no próprio documento e usava o plano pago de graça;
    // e, pior, gravava o `asaasSubscriptionId` de OUTRA estética e cancelava a
    // assinatura dela pela Cloud Function, que confiava neste campo.
    function camposDeCobranca() {
      return [
        'ownerId',
        'subscriptionStatus',
        'activeUntil',
        'trialEndsAt',
        'asaasSubscriptionId',
        'lastPaymentId',
        'lastPaymentAt',
      ];
    }

    // O trial nasce pelo cliente, no cadastro — por isso não dá para proibir os
    // campos aqui, só limitar o que eles podem valer. A janela de 8 dias cobre
    // os 7 do trial com folga de fuso, e impede trial eterno.
    function trialDeNascimentoValido() {
      return request.resource.data.subscriptionStatus == 'trial'
        && request.resource.data.activeUntil == null
        && request.resource.data.trialEndsAt is timestamp
        && request.resource.data.trialEndsAt > request.time
        && request.resource.data.trialEndsAt < request.time + duration.value(8, 'd')
        && !request.resource.data.keys().hasAny([
             'asaasSubscriptionId', 'lastPaymentId', 'lastPaymentAt',
           ]);
    }

    // ── Shops ──────────────────────────────────────────────────────────────
    // Leitura por qualquer logado (o mapa fica atrás do login — ver o grupo
    // autenticado do RootNavigator). Era `if true`, e o documento inteiro ia
    // para a internet aberta: regra do Firestore não esconde campo, então o
    // `asaasSubscriptionId` e o histórico de cobrança de TODAS as estéticas
    // eram legíveis sem login.
    //
    // Escrita só do dono, e sem tocar nos campos de cobrança.
    match /shops/{shopId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && trialDeNascimentoValido();
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDeCobranca());
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Config do shop (horários, capacidade): cliente lê p/ montar os slots,
      // só o dono escreve.
      match /settings/{docId} {
        allow read: if isSignedIn();
        allow write: if isShopOwner(shopId);
      }

      // Serviços oferecidos: cliente lê p/ agendar, só o dono escreve (impede
      // que um cliente altere preço/serviço de outra estética).
      match /services/{serviceId} {
        allow read: if isSignedIn();
        allow write: if isShopOwner(shopId);
      }

      // Agendamentos do shop.
      // - read: qualquer logado (o cálculo de disponibilidade precisa contar os
      //   agendamentos do dia; não dá p/ restringir só aos do próprio cliente).
      // - create: o cliente cria o SEU agendamento (customerUid == uid) já como
      //   'scheduled'; o dono também pode criar (encaixe/walk-in).
      // - update: o dono muda status (in_progress/done/no_show); o cliente só
      //   pode CANCELAR o próprio agendamento e apenas ANTES do horário marcado
      //   (request.time < startAtMs) — a tolerância do no_show não estende isso.
      // - delete: só o dono.
      match /appointments/{appointmentId} {
        function isCustomerCancel() {
          return isSignedIn()
            && request.auth.uid == resource.data.customerUid
            && resource.data.status == 'scheduled'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.customerUid == resource.data.customerUid
            && request.resource.data.startAtMs == resource.data.startAtMs
            && request.time.toMillis() < resource.data.startAtMs;
        }

        // Leitura só do dono ou do próprio cliente (o nome do cliente fica aqui).
        // A disponibilidade NÃO lê isto — usa os slots sem PII (abaixo).
        allow read: if isShopOwner(shopId)
          || (isSignedIn() && request.auth.uid == resource.data.customerUid);
        allow create: if isShopOwner(shopId)
          || (isSignedIn()
              && request.resource.data.customerUid == request.auth.uid
              && request.resource.data.status == 'scheduled');
        allow update: if isShopOwner(shopId) || isCustomerCancel();
        allow delete: if isShopOwner(shopId);
      }

      // Slots ocupados: espelho SEM PII dos agendamentos 'scheduled' (só os
      // horários). Leitura por qualquer logado — é o que o cálculo de
      // disponibilidade usa, pra ninguém precisar ler os agendamentos (com nome)
      // de outros clientes.
      // - create: o próprio cliente, junto com o agendamento. O getAfter garante
      //   que existe um appointment de MESMO id, DELE e no MESMO horário; o
      //   hasOnly impede qualquer campo de PII.
      // - update: ninguém pela regra (o Admin SDK da Cloud Function ignora regras
      //   e mantém o slot em sincronia).
      // - delete: o dono; a função apaga via Admin SDK quando sai de 'scheduled'.
      match /slots/{slotId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly(['startAtMs', 'endAtMs', 'dayKey', 'shopId'])
          && getAfter(/databases/$(database)/documents/shops/$(shopId)/appointments/$(slotId)).data.customerUid == request.auth.uid
          && request.resource.data.startAtMs == getAfter(/databases/$(database)/documents/shops/$(shopId)/appointments/$(slotId)).data.startAtMs;
        allow update: if false;
        allow delete: if isShopOwner(shopId);
      }

      // Sino do dono: escrito pelas Cloud Functions (Admin SDK, ignora estas
      // regras). O dono lê e pode marcar como lida.
      match /notifications/{notificationId} {
        allow read, write: if isShopOwner(shopId);
      }
    }

    // ── Usuários ───────────────────────────────────────────────────────────
    // Só o próprio usuário acessa o seu documento e subcoleções.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      // O papel é definido no cadastro e não muda mais pelo cliente. Sem isto,
      // um customer virava owner sozinho gravando role: 'owner' no próprio doc
      // e caía na interface do painel do dono. O shopId continua livre: o app
      // grava nele a "última estética usada" a cada agendamento.
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /appointments/{appointmentId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Sino do cliente: escrito pela Cloud Function, lido/marcado pelo próprio.
      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ── Pagamentos ─────────────────────────────────────────────────────────
    // Só o backend (Cloud Functions) escreve. Leitura restrita ao dono do shop
    // cobrado: `isSignedIn()` sozinho deixava qualquer cliente logado ler o
    // valor, o status e a estética de TODAS as cobranças da plataforma.
    match /payments/{paymentId} {
      allow read: if isShopOwner(resource.data.shopId);
      allow write: if false;
    }

    // ── Vínculo com o Asaas ────────────────────────────────────────────────
    // Fechado dos dois lados. Guarda o `asaasSubscriptionId` da estética, que é
    // o que a Cloud Function usa para consultar e CANCELAR a assinatura.
    //
    // Enquanto esse id morava em shops/{shopId}, o dono podia gravar nele o id
    // de outra estética e cancelar a assinatura alheia: a função conferia que o
    // documento era dele, mas não que o id dentro do documento era dele.
    // Guardar aqui tira o campo do alcance do cliente — o Admin SDK das
    // Functions ignora estas regras.
    match /shopBilling/{shopId} {
      allow read, write: if false;
    }
  }
}
