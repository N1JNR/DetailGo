# Android/IntelliJ
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/
.kotlin/
# Chaves sensíveis Android (use secrets.properties.example como template)
android/secrets.properties

# ── React Native build artifacts (gerados em tempo de build, nunca commitar) ──
android/app/src/main/assets/index.android.bundle
android/app/src/main/assets/index.android.bundle.map
android/app/src/main/res/raw/keep.xml

# ── SEGURANÇA: Keystores (nunca subir chaves de assinatura) ──────────────────
*.keystore
*.jks
# debug.keystore também ignorado — não expor chave de assinatura

# ── SEGURANÇA: Firebase / Google Services ────────────────────────────────────
# Contém API keys, project IDs e configurações do Firebase
google-services.json
GoogleService-Info.plist

# ── SEGURANÇA: Variáveis de ambiente e secrets ────────────────────────────────
.env
.env.local
.env.production
.env.staging
.env.development
*.secret
*.secrets

# ── SEGURANÇA: Chaves privadas e certificados ────────────────────────────────
*.pem
*.p12
*.key
*.cer
*.der
serviceAccountKey.json
*service-account*.json
*credentials*.json

# ── SEGURANÇA: Firebase Functions secrets locais ────────────────────────────
functions/.env
functions/.env.*
functions/.secret.*

