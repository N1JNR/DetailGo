# Copie para secrets.properties e preencha. Este arquivo NAO e rastreado.

# Google Maps SDK for Android
# Gere em: https://console.cloud.google.com -> APIs & Services -> Credentials
# Restrinja a chave ao applicationId e as SHA-1 das suas keystores.
GOOGLE_MAPS_API_KEY=

# Keystore de UPLOAD da Play Store (Play App Signing).
# Gere com:
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore android/app/upload.keystore -alias detailgo-upload \
#     -keyalg RSA -keysize 4096 -validity 10000
# Sem estas quatro linhas o build de release falha de proposito, para nao
# publicar assinado com a chave de debug.
UPLOAD_STORE_FILE=upload.keystore
UPLOAD_KEY_ALIAS=detailgo-upload
UPLOAD_STORE_PASSWORD=
UPLOAD_KEY_PASSWORD=
